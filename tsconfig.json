{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "outDir": "dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "rewriteRelativeImportExtensions": true,
    "lib": [
      "ES2023",
      "DOM"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "web/src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
