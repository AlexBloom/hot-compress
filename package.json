{
  "name": "hot-compress",
  "version": "0.2.0",
  "description": "Local-first web image and video optimization",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "hot-compress": "bin/hot-compress.mjs"
  },
  "scripts": {
    "build": "tsc && vite build",
    "dev": "npm run build && node bin/hot-compress.mjs gui",
    "start": "node bin/hot-compress.mjs gui",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc --noEmit && tsc -p tsconfig.web.json",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "package:skill": "npm run build && node scripts/package-skill.mjs",
    "build:site": "node scripts/build-site.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.72.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  }
}
